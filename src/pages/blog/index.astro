---
import { getCollection } from 'astro:content';
import BlogIndex from '../../layouts/BlogIndex.astro';
import { POSTS_PER_PAGE, withBase } from '../../consts';

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const totalPages = Math.max(1, Math.ceil(all.length / POSTS_PER_PAGE));
const posts = all.slice(0, POSTS_PER_PAGE);
---

<BlogIndex
	posts={posts}
	allPosts={all}
	totalPosts={all.length}
	currentPage={1}
	totalPages={totalPages}
	prevUrl={null}
	nextUrl={totalPages > 1 ? withBase('/blog/page/2/') : null}
/>
