---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagList from '../../components/TagList.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../../consts';
import { getReadingStats } from '../../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container">
			<header class="page-head">
				<p class="eyebrow">Blog</p>
				<h1>All posts</h1>
				<p class="lead">
					{SITE_DESCRIPTION} <span class="count">({posts.length} posts)</span>
				</p>
			</header>

			<ul class="post-list">
				{
					posts.map((post) => {
						const { minutes } = getReadingStats(post.body);
						return (
							<li class="post-item">
								<h2 class="post-title">
									<a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
								</h2>
								<p class="post-desc">{post.data.description}</p>
								<div class="post-meta">
									<FormattedDate date={post.data.pubDate} />
									<span aria-hidden="true">·</span>
									<span>{minutes} min read</span>
								</div>
								<TagList tags={post.data.tags} />
							</li>
						);
					})
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		padding-block: 4rem 2.5rem;
		max-width: 640px;
	}

	.page-head h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.2rem, 5vw, 3rem);
		letter-spacing: -0.03em;
	}

	.lead {
		margin: 0;
		font-size: 1.15rem;
		color: var(--text-muted);
	}

	.count {
		color: var(--text-faint);
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}

	.post-item {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-block: 1.8rem;
		border-bottom: 1px solid var(--border);
	}

	.post-title {
		margin: 0;
		font-size: 1.45rem;
	}

	.post-title a {
		color: var(--text);
		text-decoration: none;
	}

	.post-title a:hover {
		color: var(--accent);
	}

	.post-desc {
		margin: 0;
		max-width: 62ch;
		color: var(--text-muted);
	}

	.post-meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.85rem;
		color: var(--text-faint);
	}
</style>
