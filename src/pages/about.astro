---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR, AVATAR, SCHOOL, SITE_TITLE, withBase } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={`About ${AUTHOR}.`} />
	</head>
	<body>
		<Header />
		<main class="container">
			<div class="about-head">
				<img class="avatar" src={withBase(AVATAR)} alt={AUTHOR} width="112" height="112" />
				<div>
					<p class="eyebrow">About</p>
					<h1>{AUTHOR}</h1>
					<p class="school">{SCHOOL}</p>
				</div>
			</div>

			<div class="prose about-body">
				<p>
					Hi, I'm {AUTHOR} — a student at {SCHOOL}. This is where I write about the things I'm learning:
					software, systems, and the occasional rabbit hole.
				</p>

				<h2>What I write about</h2>
				<ul>
					<li>Web development and the tools I use day to day</li>
					<li>Notes from coursework and side projects</li>
					<li>Things I wish I'd known earlier</li>
				</ul>

				<h2>Get in touch</h2>
				<p>
					The best place to reach me is <a href="https://github.com/askiki12" target="_blank" rel="noopener"
						>GitHub</a
					>. More links are in the footer.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-head {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		padding-block: 4.5rem 2rem;
	}

	.avatar {
		flex: none;
		width: 112px;
		height: 112px;
		border-radius: 50%;
		border: 2px solid var(--border);
	}

	.about-head h1 {
		margin: 0.25rem 0;
		font-size: clamp(2rem, 5vw, 2.75rem);
		letter-spacing: -0.03em;
	}

	.school {
		margin: 0;
		font-weight: 600;
		color: var(--accent);
	}

	.about-body {
		max-width: 680px;
	}

	@media (max-width: 560px) {
		.about-head {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
	}
</style>
