---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DocumentTree from '../components/DocumentTree.astro';
import { withBase } from '../consts';
import { buildPostTree, findParentNode, flattenPostsInTree, type ReadingStats } from '../utils';

type Props = Omit<CollectionEntry<'blog'>['data'], 'tags'> & {
	currentPath?: string;
	tags?: string[];
	headings?: MarkdownHeading[];
	stats?: ReadingStats;
};

const {
	currentPath = '',
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	headings = [],
	stats,
} = Astro.props;

const hasToc = headings.length > 0;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const tree = buildPostTree(posts);
const parentNode = currentPath ? findParentNode(tree, currentPath) : null;
const parentHref = parentNode ? withBase(`/blog/${parentNode.path}/`) : withBase('/');
const parentLabel = parentNode ? parentNode.title : 'Home';

// Previous/next follow the document-tree order (DFS pre-order), matching the tree UI.
const ordered = flattenPostsInTree(tree);
const currentIndex = ordered.findIndex((post) => post.id === currentPath);
const prevPost = currentIndex > 0 ? ordered[currentIndex - 1] : null;
const nextPost = currentIndex >= 0 && currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : null;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<div class:list={['post-shell', { 'no-toc': !hasToc }]} id="post-shell">
			<aside class="post-sidebar sidebar-left" aria-label="Post tree">
				<DocumentTree currentPath={currentPath} />
			</aside>

			<main class="post-main">
				<article class="post">
					<div class="post-toolbar">
						<div class="post-toolbar-left">
							<button id="back-page" class="back-link" type="button" title="Back to previous page">
								<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path d="M19 12H5"></path>
									<path d="m12 19-7-7 7-7"></path>
								</svg>
								<span class="back-label">Back</span>
							</button>
							<a class="back-link" href={parentHref} title={`Back to ${parentLabel}`}>
								<svg
									viewBox="0 0 24 24"
									width="16"
									height="16"
									fill="none"
									stroke="currentColor"
									stroke-width="1.8"
									aria-hidden="true"
								>
									<path d="M12 19V5"></path>
									<path d="m5 12 7-7 7 7"></path>
								</svg>
								<span class="back-label">{parentLabel}</span>
							</a>
						</div>
						<div class="post-toolbar-actions">
						<button
							id="toggle-tree"
							class="icon-btn"
							type="button"
							title="Toggle document tree"
							aria-controls="post-shell"
							aria-expanded="true"
						>
							<span class="sr-only">Toggle document tree</span>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
								<rect x="3" y="4" width="18" height="16" rx="2"></rect>
								<line x1="9" y1="4" x2="9" y2="20"></line>
							</svg>
						</button>
						{
							hasToc && (
								<button
									id="toggle-toc"
									class="icon-btn"
									type="button"
									title="Toggle table of contents"
									aria-controls="post-shell"
									aria-expanded="true"
								>
									<span class="sr-only">Toggle table of contents</span>
									<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
										<line x1="9" y1="6" x2="20" y2="6"></line>
										<line x1="9" y1="12" x2="20" y2="12"></line>
										<line x1="9" y1="18" x2="20" y2="18"></line>
										<circle cx="4.5" cy="6" r="1.2"></circle>
										<circle cx="4.5" cy="12" r="1.2"></circle>
										<circle cx="4.5" cy="18" r="1.2"></circle>
									</svg>
								</button>
							)
						}
						</div>
					</div>

					<header class="post-header">
						<h1>{title}</h1>
						{description && <p class="description">{description}</p>}
						<div class="meta">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<>
										<span aria-hidden="true">·</span>
										<span>
											Updated <FormattedDate date={updatedDate} />
										</span>
									</>
								)
							}
							{
								stats && (
									<>
										<span aria-hidden="true">·</span>
										<span>{stats.minutes} min read</span>
										<span aria-hidden="true">·</span>
										<span>{stats.words} words</span>
									</>
								)
							}
						</div>
						<TagList tags={tags} />
					</header>

					{heroImage && <Image class="hero" width={1120} height={560} src={heroImage} alt="" />}

					<div class="prose">
						<slot />
					</div>

					{
						(prevPost || nextPost) && (
							<nav class="post-nav" aria-label="Post navigation">
								{prevPost ? (
									<a class="post-nav-link prev" href={withBase(`/blog/${prevPost.id}/`)}>
										<span class="post-nav-label">&larr; Previous</span>
										<span class="post-nav-title">{prevPost.data.title}</span>
									</a>
								) : (
									<span class="post-nav-spacer" />
								)}
								{nextPost ? (
									<a class="post-nav-link next" href={withBase(`/blog/${nextPost.id}/`)}>
										<span class="post-nav-label">Next &rarr;</span>
										<span class="post-nav-title">{nextPost.data.title}</span>
									</a>
								) : (
									<span class="post-nav-spacer" />
								)}
							</nav>
						)
					}
				</article>
			</main>

			{
				hasToc && (
					<aside class="post-sidebar sidebar-right" aria-label="Table of contents">
						<TableOfContents headings={headings} />
					</aside>
				)
			}
		</div>
		<Footer />
	</body>
</html>

<script>
	const shell = document.getElementById('post-shell');
	if (shell) {
		const wide = window.matchMedia('(min-width: 1281px)');
		const state = {
			tree: localStorage.getItem('sidebar-tree') ?? (wide.matches ? 'open' : 'closed'),
			toc: localStorage.getItem('sidebar-toc') ?? (wide.matches ? 'open' : 'closed'),
		};

		const apply = () => {
			shell.classList.toggle('hide-tree', state.tree === 'closed');
			shell.classList.toggle('hide-toc', state.toc === 'closed');
			document.getElementById('toggle-tree')?.setAttribute('aria-expanded', String(state.tree === 'open'));
			document.getElementById('toggle-toc')?.setAttribute('aria-expanded', String(state.toc === 'open'));
		};

		const toggle = (key: 'tree' | 'toc') => {
			state[key] = state[key] === 'open' ? 'closed' : 'open';
			localStorage.setItem(`sidebar-${key}`, state[key]);
			apply();
		};

		apply();
		document.getElementById('toggle-tree')?.addEventListener('click', () => toggle('tree'));
		document.getElementById('toggle-toc')?.addEventListener('click', () => toggle('toc'));
	}

	const backPage = document.getElementById('back-page');
	backPage?.addEventListener('click', () => {
		if (window.history.length > 1) {
			window.history.back();
		} else {
			window.location.href = import.meta.env.BASE_URL;
		}
	});
</script>

<style>
	.post-shell {
		--tree-w: 240px;
		--toc-w: 220px;
		display: grid;
		/* Center track is fixed (capped at --content); the two side tracks share
		   the rest equally, so the article is always centered in the viewport and
		   never moves or resizes when a sidebar is toggled. */
		grid-template-columns: minmax(0, 1fr) minmax(0, var(--content)) minmax(0, 1fr);
		column-gap: 2rem;
		/* width:100% is required: as a flex item, `margin-inline:auto` alone makes
		   the shell shrink-to-fit, so the side tracks would change with content. */
		width: 100%;
		max-width: 1600px;
		margin-inline: auto;
		padding-inline: 1.25rem;
		padding-block: 2rem 3rem;
		align-items: start;
		/* Grow to fill the page so the footer sticks to the bottom. */
		flex: 1 0 auto;
	}

	.post-shell.hide-tree .sidebar-left,
	.post-shell.hide-toc .sidebar-right {
		display: none;
	}

	.post-sidebar {
		position: sticky;
		top: 5rem;
		max-height: calc(100vh - 6rem);
		overflow-y: auto;
	}

	.sidebar-left {
		grid-column: 1;
		justify-self: end;
		width: 100%;
		max-width: var(--tree-w);
		padding-right: 1.5rem;
		border-right: 1px solid var(--border);
	}

	.post-main {
		grid-column: 2;
		min-width: 0;
	}

	.sidebar-right {
		grid-column: 3;
		justify-self: start;
		width: 100%;
		max-width: var(--toc-w);
		padding-left: 1.25rem;
		border-left: 1px solid var(--border);
	}

	/* Stable reading column: same width with or without cover, and it does not
	   jump when a sidebar is toggled. */
	.post {
		max-width: var(--content);
		margin-inline: auto;
	}

	.post-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.post-toolbar-left {
		display: flex;
		flex: 1 1 auto;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}

	.post-toolbar-actions {
		display: flex;
		flex: none;
		gap: 0.5rem;
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
		padding: 0.4rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: var(--bg-elevated);
		color: var(--text-muted);
		font-family: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.back-link:hover {
		color: var(--accent);
		border-color: var(--accent);
		text-decoration: none;
	}

	.back-link svg {
		flex: none;
	}

	.back-label {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 9px;
		background: var(--bg-elevated);
		color: var(--text-muted);
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	.icon-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.post-header {
		margin-bottom: 2rem;
	}

	.post-header h1 {
		margin: 0.75rem 0;
		font-size: clamp(2rem, 5vw, 2.9rem);
		letter-spacing: -0.03em;
	}

	.description {
		margin: 0 0 1rem;
		font-size: 1.15rem;
		color: var(--text-muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.88rem;
		color: var(--text-faint);
	}

	.hero {
		display: block;
		width: 100%;
		border-radius: var(--radius);
		margin-bottom: 2rem;
	}

	.post-nav {
		display: flex;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}

	.post-nav-link {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		padding: 0.9rem 1.1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--bg-elevated);
		text-decoration: none;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.post-nav-link:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
		text-decoration: none;
	}

	.post-nav-link.next {
		text-align: right;
	}

	.post-nav-label {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.post-nav-title {
		overflow: hidden;
		color: var(--text);
		font-weight: 600;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.post-nav-spacer {
		flex: 1;
	}

	@media (max-width: 560px) {
		.post-nav {
			flex-direction: column;
		}

		.post-nav-spacer {
			display: none;
		}

		.post-nav-link.next {
			text-align: left;
		}
	}

	@media (max-width: 1280px) {
		.post-shell {
			display: block;
			max-width: none;
		}

		.post-sidebar {
			position: static;
			width: auto;
			max-width: none;
			max-height: none;
			margin-bottom: 1.5rem;
			padding: 1rem;
			border: 1px solid var(--border);
			border-radius: var(--radius-sm);
			background: var(--bg-muted);
		}

		.post-toolbar {
			margin-bottom: 1rem;
		}
	}
</style>
