---
import { withBase } from '../consts';
import { tagSlug } from '../utils';

interface Props {
	tags?: string[];
	class?: string;
}

const { tags = [], class: className } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class:list={['tag-list', className]}>
			{tags.map((tag) => (
				<li>
					<a href={withBase(`/tags/${tagSlug(tag)}/`)}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}
