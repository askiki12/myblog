---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { withBase } from '../consts';
import { getReadingStats } from '../utils';
import { getCover } from '../covers';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const { minutes } = getReadingStats(post.body);
const cover = getCover(post);
---

<article class="post-card">
	<a class="card-link" href={withBase(`/blog/${post.id}/`)}>
		<div class="thumb">
			<Image width={720} height={400} src={cover} alt="" loading="lazy" />
		</div>
		<div class="card-body">
			<h3>{title}</h3>
			<p class="desc">{description}</p>
			<div class="meta">
				<FormattedDate date={pubDate} />
				<span aria-hidden="true">·</span>
				<span>{minutes} min read</span>
			</div>
		</div>
	</a>
</article>

<style>
	.post-card {
		height: 100%;
	}

	.card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-elevated);
		box-shadow: var(--shadow-sm);
		color: inherit;
		text-decoration: none;
		transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
	}

	.card-link:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow);
		border-color: var(--border-strong);
		text-decoration: none;
		color: inherit;
	}

	.thumb {
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: var(--bg-muted);
	}

	.thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.card-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.1rem 1.2rem 1.25rem;
	}

	h3 {
		margin: 0;
		font-size: 1.2rem;
		line-height: 1.35;
	}

	.desc {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: auto;
		padding-top: 0.4rem;
		font-size: 0.82rem;
		color: var(--text-faint);
	}
</style>
